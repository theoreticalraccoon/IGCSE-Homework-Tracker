# Copy to ingest/.env and fill in. Never commit the real file.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The SERVICE ROLE key. It bypasses row-level security, so it belongs only
# here — never in index.html, never in an edge function that takes user input.
SUPABASE_SERVICE_ROLE_KEY=

# One or more Gemini keys from https://aistudio.google.com/apikey
# The free tier is rate-limited PER KEY, so adding a second key roughly doubles
# ingestion throughput. Comma-separated, no spaces.
GEMINI_API_KEYS=

# Optional overrides.
# GEMINI_CHAT_MODEL is a FALLBACK CHAIN, tried left to right. Free-tier quota is
# per model as well as per key, so when the flagship model is exhausted the run
# continues on the next one instead of failing.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Parallel paper groups. Each one makes Gemini calls, so keep this near
# (number of keys x 2) to stay inside the free-tier rate limit.
INGEST_CONCURRENCY=4
EMBED_BATCH=96

# Set to 0 to run the free, deterministic parsers only — faster and costs no
# quota, but badly laid-out papers will parse poorly.
INGEST_LLM_PARSE=1
INGEST_LLM_CLASSIFY=1
